# Défense supply-chain : refuse tout paquet publié il y a moins de 24h.
# Si une version compromise est publiée sur npm, la communauté a typiquement
# le temps de la détecter et de la retirer avant qu'elle ne soit installée ici.
# Valeur en minutes (1440 = 24h). Requiert pnpm >= 10.
minimum-release-age=1440

# Force l'engine déclarée dans package.json au lieu de juste warner.
engine-strict=true

# Évite les approvisionnements interactifs en CI.
fund=false
audit=false
update-notifier=false

# Empêche pnpm d'exécuter les scripts post-install des dépendances sans
# approbation explicite (postinstall = vecteur classique de compromission
# supply-chain).
#
# Cas de Playwright : son script d'install sert à TÉLÉCHARGER les navigateurs.
# Ici l'image de base mcr.microsoft.com/playwright les fournit déjà dans
# /ms-playwright, exposé par la variable PLAYWRIGHT_BROWSERS_PATH. Le script
# est donc non seulement inutile mais indésirable — il retéléchargerait des
# centaines de Mo à chaque build. Playwright résout ses navigateurs au runtime
# via cette variable, sans avoir besoin de son étape d'install.
ignore-scripts=true
